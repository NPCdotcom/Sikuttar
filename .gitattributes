# Normalize line endings across Windows / Unix agents
* text=auto eol=lf

# Windows scripts keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.7z binary

# Generated / lock files: merge as ours-less noise
package-lock.json -diff
yarn.lock -diff
poetry.lock -diff
