{
  "name": "sikuttar",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev:api": "wrangler dev",
    "dev:web": "npm run dev -w apps/web",
    "build:web": "npm run build -w apps/web",
    "deploy": "npm run build:web && wrangler deploy",
    "backfill:embeddings": "node scripts/backfill-embeddings.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "hono": "^4.7.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7",
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true
  }
}
