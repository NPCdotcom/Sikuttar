# Local agent memory — not committed to git
# Canonical docs live under docs/ after promotion (glossary, adr, design, plans).
# See docs/MEMORY_ARCHITECTURE.md

.agents/memory/*
!.agents/memory/README.md
!.agents/memory/knowledge/_template.md
!.agents/memory/traces/README.md
!.agents/memory/evaluations/README.md
!.agents/memory/rewards/README.md
!.agents/memory/index.yaml.example

# Cursor junctions (generated by scripts/link-cursor.ps1 — do not commit)
.cursor/rules
.cursor/skills
.cursor/hooks
.cursor/hooks.json

# Agent env (generated by env/bin/setup — do not commit)
env/python/.venv/
env/node/node_modules/

# Learning sandbox — large / local-only
learning/**/sources/**
learning/**/.venv/
learning/**/node_modules/
learning/**/__pycache__/
learning/**/.pytest_cache/
