# copy-kit.exclude — never copy (relative to kit root)
# Synced with docs/BOOTSTRAP_MANIFEST.md
# Patterns: exact path prefix or glob-style (** not required; prefix match)

# Learning — keep only _template / README / index.yaml.example (handled by include list)
learning/minecraft/
learning/wolfram/
learning/cpp/
learning/ltspice/
learning/npcdotcom/
learning/physics/
learning/math/
learning/geoscience/
learning/**/sources/
learning/**/.venv/
learning/**/node_modules/

# Global memory — home canonical only; consumer gets pointer README via copy-kit
memory/global/index.yaml
memory/global/knowledge/
memory/global/index/

# Project live memory (regenerate from examples)
memory/state/nav.yaml
memory/index.yaml
memory/episodes/
memory/traces/
memory/evaluations/
memory/history/
memory/rewards/rollup.yaml
memory/audit/audit-log.md

# Runtime / generated
env/python/.venv/
env/node/node_modules/
.cursor/
.git/
__pycache__/
*.pyc
.pytest_cache/
